# Server environment variables (set them in the Render dashboard; locally the defaults work).
# The server reads them from the environment — it does not load .env files itself.

# Port to listen on. Render sets this automatically. Default: 3001
PORT=3001

# Comma-separated list of allowed browser origins (CORS). "*" matches one subdomain part.
# Default: http://localhost:5173
CLIENT_URL=http://localhost:5173,https://your-app.vercel.app,https://*.vercel.app
